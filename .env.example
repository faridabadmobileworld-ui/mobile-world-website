# ─────────────────────────────────────────────────────────────
# इस file में कभी असली चाबी मत लिखिए। यह सिर्फ़ नमूना है।
# असली values Vercel → Settings → Environment Variables में जाती हैं।
# (.env* पहले से .gitignore में है।)
# ─────────────────────────────────────────────────────────────

# Instagram की live feed के लिए — पूरा तरीक़ा docs/INSTAGRAM-SETUP.md में
IG_TOKEN=
# मर्ज़ी से — न भरें तो "me" चलता है
IG_USER_ID=

# Domain बदलना हो तो (वरना data/shop.ts वाला पता चलता है)
NEXT_PUBLIC_SITE_URL=
